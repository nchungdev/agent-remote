#!/usr/bin/env bash
# project-pro pre-commit gate: Staged Secret Scan + Clean Arch Boundary + Anti-God-File (<= 300 LOC)
set -euo pipefail
ROOT_DIR="$(git rev-parse --show-toplevel)"
if command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] Running gitleaks staged secret scan..."
  gitleaks protect --staged --redact --no-banner
fi
if [ -f "/Users/chungnh/.gemini/config/skills/project-pro/scripts/project_pro.py" ]; then
  echo "[pre-commit] Running project-pro staged architecture & security audit..."
  python3 "/Users/chungnh/.gemini/config/skills/project-pro/scripts/project_pro.py" audit --target "$ROOT_DIR" --staged --fail-on-error
fi
if [ -f "$ROOT_DIR/scripts/check_project.py" ]; then
  echo "[pre-commit] Running agent-remote hygiene, secret/IP & LOC verification..."
  python3 "$ROOT_DIR/scripts/check_project.py"
fi
